# MediTrack environment template — copy to .env (keep .env out of git).
# Note: .env is bundled as a Flutter asset (see pubspec.yaml), so it must
# exist before the app builds. Variable names must match lib/config/api_config.dart.

# --- AI assistant (OpenRouter) ---
# Get a key at https://openrouter.ai — used by OpenRouterAiService (openrouter/free).
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# --- AppsPro / BD Apps carrier billing (Robi/Airtel subscription flow) ---
# Deployed Firebase appsProProxy HTTPS URL. This is non-secret.
APPSPRO_PROXY_URL=https://asia-south1-meditrack-app-2026.cloudfunctions.net/appsProProxy

# Publishable AppsPro key. This is safe in the Flutter asset.
APPSPRO_PUBLISHABLE_KEY=YOUR_APPS_PRO_PUBLISHABLE_KEY

# Application UUID from the AppsPro developer dashboard.
App_ID=YOUR_APPS_PRO_APP_ID

# Hosted checkout share URL.
Share_URL=https://appspro.dev/YOUR_CHECKOUT_URL

# Never add APPS_PRO_SECRET_KEY here. Set it only with:
# firebase functions:secrets:set APPSPRO_SECRET_KEY
