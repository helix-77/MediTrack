# Gemini API Key Template
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# BDApps Integration Settings
# Option A: Custom PHP Proxy Server URL (Recommended for production backend)
BDAPPS_SERVER_URL=https://your-domain.com/path

# Option B: Direct BDApps TAP API Credentials
BDAPPS_APP_ID=APP_000000
BDAPPS_PASSWORD=your_bdapps_password
